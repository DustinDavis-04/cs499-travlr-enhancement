<div id="background">
	<div id="page">
		{{> header}}

		<div id="contents">
			<div class="box">
				<div>
					<div class="body">
						<h1>{{title}}</h1>
						<ul id="sites">
							{{#each trips}}
							<li>
								<a href="/travel"><img src="{{image}}" alt="Img"></a>
								<h2><a href="/travel">{{name}}</a></h2>
								<p>
									{{description}}
								</p>
								<p>
									Length: {{length}}
									<br>
									Resort: {{resort}}
									<br>
									Per Person: ${{perPerson}}
								</p>
							</li>
							{{/each}}
						</ul>
					</div>
				</div>
			</div>
		</div>

	</div>
	
	{{> footer}}
</div>